# Banco de Dados PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=acordos_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/acordos_db

# AWS / LocalStack (SQS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
SQS_QUEUE_NAME=acordos-juridicos-queue
SQS_DLQ_NAME=acordos-juridicos-dlq
SQS_QUEUE_URL=http://localstack:4566/000000000000/acordos-juridicos-queue
SQS_DLQ_URL=http://localstack:4566/000000000000/acordos-juridicos-dlq

# API Pública Externa (JSONPlaceholder)
EXTERNAL_API_BASE_URL=https://jsonplaceholder.typicode.com
EXTERNAL_API_TIMEOUT=15.0
EXTERNAL_API_MAX_RETRIES=3
PRODUCER_MAX_USERS=10

# Autenticação JWT & Segurança da API
JWT_SECRET_KEY=super-secret-jwt-key-acordos-juridicos-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_ADMIN_USER=admin
API_ADMIN_PASSWORD=admin123
API_KEY_HEADER=X-API-Key
API_STATIC_KEY=chave-secreta-api-acordos-2026

# Observabilidade e Aplicação
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CONSUMER_POLL_INTERVAL_SECONDS=2
CONSUMER_MAX_MESSAGES=10
